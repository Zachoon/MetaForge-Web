{
  "name": "metaforge-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:harness": "node tests/validation-harness/run.mjs --mode smoke",
    "validate:harness:field": "node tests/validation-harness/run.mjs --mode field --limit 104 --baseline tests/validation-harness/brain-v1-frozen-benchmark.json",
    "validate:golden": "node tests/validation-harness/run-golden.mjs",
    "validate:field-intelligence": "node --test tests/field-intelligence.test.mjs",
    "validate:brain-v2-exp001": "node --test tests/brain-v2-exp001.test.mjs",
    "report:brain-v2-exp001": "node tests/brain-v2-exp001/run.mjs --mode smoke",
    "report:brain-v2-exp001:field": "node tests/brain-v2-exp001/run.mjs --mode field --limit 104 --baseline tests/validation-harness/brain-v1-frozen-benchmark.json",
    "report:field-intelligence": "node tests/field-intelligence/run.mjs",
    "report:field-intelligence:live": "node tests/field-intelligence/run.mjs --live",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.39.1",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "jose": "^5.10.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": "4.20260714.0"
  }
}
