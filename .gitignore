# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# wrangler local-dev-only vars — never uploaded by `wrangler deploy`,
# and must never contain anything that could weaken production auth
.dev.vars

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
dev-server.log
dev-server-error.log
dev-server.pid

# Local MetaForge safety snapshots
backups/
batch-backups/

# Academy live observatory cache (raw TopDeck chunks + checkpoints)
/tests/field-intelligence/live-cache/

# Claude Code local tool config
/.claude/

# Local preview/codex logs
.codex-forge-preview*.log
.codex-preview-latest*.log

# Local sites-package staging builds and their upload archives
/.sites-package-stage-*/
/.sites-upload-*.tar.gz

# Build/trace caches and run-output dumps
tsconfig.tsbuildinfo
native_revision_capture.txt
torture-bench-run.txt
/tests/knowledge/out/
/tests/**/*.log

# Manual pre-edit backup copies (naming convention: <file>.before-<change>)
*.before-*
