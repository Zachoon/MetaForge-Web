{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metaforge-private-alpha",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-14",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "metaforge.gg", "custom_domain": true },
    { "pattern": "www.metaforge.gg", "custom_domain": true },
    { "pattern": "app.metaforge.gg", "custom_domain": true }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "METAFORGE_BOOTSTRAP_LOCK": "unlocked",
    "METAFORGE_FOUNDER_USER_KEY": "f45237c471be9524242fb124700a61b6916cbbff9967c8ba74e43af0617bea90",
    // Cloudflare Access verification parameters for worker/access-identity.ts.
    // Not secrets — the team domain and an Access application's Audience
    // (AUD) tag are public verifier parameters (same category as an OAuth
    // issuer URL/client_id), and both are already visible in the login
    // redirect Access itself sends to any unauthenticated visitor.
    "ACCESS_TEAM_DOMAIN": "long-water-f05e.cloudflareaccess.com",
    "ACCESS_AUD": "6d1c3df5e4c198c39d39e4caf4c7fd5386ec65de6c5558b99570dec8871e0a23,8376767e20ac9929d4e3af8fde3000cb193ec7b4c44fb6657682d5cf87ad20be",
    // TCGplayer is confirmed joined in the Impact dashboard and every
    // purchase link is wrapped through the verified deep-link mechanism —
    // not a secret. See app/affiliate-links.mjs and worker/index.ts's
    // /api/forge/status.
    "TCGPLAYER_AFFILIATE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metaforge-private-alpha-accounts",
      "database_id": "a16911c8-9a3a-4c97-bfe2-0ad68b19edf0",
      "migrations_dir": "migrations"
    }
  ]
}
